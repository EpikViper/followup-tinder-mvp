      "name": "Gate idempotent action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst request=$('Parse signed action').first().json;const rows=$input.all().map(i=>i.json).filter(r=>r.case_key);const c=rows.sort((a,b)=>new Date(b.updated_at||0)-new Date(a.updated_at||0))[0]||{};\nreturn [{json:{...request,case:c,replay:c.status==='resolved',recorded:c.action_result||''}}];\n"
      }
    },
