      "id": "action-record-action-outcome",
      "name": "Record action outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst gate=$('Gate idempotent action').first().json;const result=$input.first().json||{};const text=result.ok?'Decision recorded: '+gate.action.type.replaceAll('_',' '):'Decision could not be completed: '+(result.error||result.status||'unknown error');\nreturn [{json:{...gate,result,text,ok:Boolean(result.ok)}}];\n"
      }
    },
