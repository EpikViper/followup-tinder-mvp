        "jsCode": "const gate=$('Gate idempotent action').first().json;const row=$input.all().map(i=>i.json).find(r=>r.case_key)||{};return [{json:{...gate,ownsClaim:String(row.action_nonce||'')===String($execution.id)}}];"
