      "name": "Resume reviewed event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst gate=$('Gate idempotent action').first().json;const row=$input.all().map(i=>i.json).find(r=>r.normalized_event);if(!row)throw new Error('Original event is unavailable');\nreturn [{json:{source:'action',event:JSON.parse(row.normalized_event),action:gate.action,preferredCompanyId:gate.case.company_id||'',companyEvidence:{name:gate.case.company_name||'',domain:gate.case.company_domain||'',evidence:gate.case.company_evidence||''}}}];\n"
      }
    },
