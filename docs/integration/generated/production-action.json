            "status": "={{ $json.ok ? 'resolved' : 'waiting_review' }}",
            "resolution": "={{ $json.action.type }}",
            "resolved_at": "={{ $json.ok ? $now.toISO() : null }}",
            "updated_at": "={{ $now.toISO() }}",
            "action_nonce": "={{ $execution.id }}",
            "action_result": "={{ $json.text }}"
          }
        },
        "options": {}
